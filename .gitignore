# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
# Build directories: their contents are ignored, but the compiled reference
# executables are kept -- see "Reference executables" at the end of this file.
**/build/*
**/Build/*
out/
bin/
lib/
Debug/
Release/
RelWithDebInfo/
MinSizeRel/
x64/
x86/
Win32/
cmake-build-*/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Makefile
compile_commands.json
_deps/

# ---------------------------------------------------------------
# Compiled objects / binaries
# (models/**/*.obj are 3D meshes, not compiler output -- keep them)
# ---------------------------------------------------------------
*.o
*.obj
!models/**/*.obj
!**/models/**/*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.d
*.gch
*.pch
*.ipch
*.ilk
*.exp
*.idb
*.pdb
*.map
*.su
*.i*86
*.x86_64
*.hex
*.elf

# Assignment 0/1 rasterizer binaries (no extension on Linux)
Rasterizer_correct
Rasterizer_incorrect

# ---------------------------------------------------------------
