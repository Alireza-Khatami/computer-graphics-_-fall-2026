# ---------------------------------------------------------------
.vs/
*.VC.db
*.VC.opendb
*.suo
*.wsuo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------
# Render output (large, regenerable)
# ---------------------------------------------------------------
*.ppm
*.pfm
*.hdr
*.exr
binary.ppm
output.ppm

# ---------------------------------------------------------------
# Archives (submissions / re-downloadable course bundles)
# ---------------------------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------
# OS / filesystem cruft
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
__MACOSX/
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*:Zone.Identifier

# ---------------------------------------------------------------
# Databases / caches
# ---------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------
# Blender working files
# ---------------------------------------------------------------
*.blend1
*.blend2

# Compiled ray tracer binary (assignment 5)
RayTracing

# ---------------------------------------------------------------
# Reference executables
# The compiled binaries are committed on purpose so that a working
# reference build is available without compiling from source.
# These negations must stay at the end of the file: for a given path the
# LAST matching pattern wins.
# ---------------------------------------------------------------
!**/build/Rasterizer
!**/build/Rasterizer_*
!**/build/RST
!**/build/SRT
!**/build/TRS
!**/build/TSR
!**/build/BezierCurve
!**/build/BezierCurve_*
!**/build/RayTracing
!**/build/RayTracing_*
!**/build/*.exe
!**/Rasterizer_correct
!**/Rasterizer_incorrect
